# Copy to .env (never commit it). Read by BOTH docker compose and the backend.
# Host ports are non-default so this stack can run beside other local projects.

# ---- Infra: host ports + Postgres credentials (docker compose) ----
POSTGRES_PORT=5434
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox
REDIS_PORT=6380
ES_PORT=9200

# ---- Backend connection strings (must match the infra values above) ----
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5434/reachinbox
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200
# Search index is <prefix>-emails (tests use their own prefix).
ES_INDEX_PREFIX=reachinbox
ES_BULK_CHUNK_SIZE=500
# Kept short so a slow cluster can't stall scheduling or sending.
ES_REQUEST_TIMEOUT_MS=5000
SEARCH_MAX_PAGE_SIZE=100
# Max pageSize for GET /api/emails.
LIST_MAX_PAGE_SIZE=100

# ---- API / URLs ----
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ---- Schedule API (M4) ----
# Per-request caps; leads are deduped/validated server-side.
MAX_LEADS_PER_CAMPAIGN=10000
MAX_EMAIL_BODY_CHARS=20000
# Jobs per BullMQ addBulk call when enqueueing a campaign.
ENQUEUE_CHUNK_SIZE=500

# ---- Queue and rate limits (M3-M5) ----
# All BullMQ keys live under this Redis prefix (tests use their own).
BULLMQ_PREFIX=reachinbox
WORKER_CONCURRENCY=5
# Send attempts per email before it is marked FAILED; exponential backoff base.
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000
# Every cap below uses 0 = off.
# Length of one rate-limit window. 3600000 = UTC hours; shorten for demos/tests.
RATE_LIMIT_WINDOW_MS=3600000
# Provider cap: max emails per sender per window, shared by all campaigns.
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Optional global cap across all senders per window.
MAX_EMAILS_PER_HOUR=0
# Global floor between any two sends, across all workers (BullMQ limiter).
# Caps throughput at 3600000 / this value per hour; lower it for the load demo.
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Gap between emails pushed into the next window by the runtime limiter.
RESCHEDULE_SPACING_MS=1000
# Schedule requests whose plan would end beyond this many days are rejected (400).
PLANNING_HORIZON_DAYS=30
# Timeout for the locked plan+insert transaction (large campaigns).
SCHEDULE_TX_TIMEOUT_MS=60000

# ---- Crash recovery (M6): worker-boot reconcile ----
# Each SMTP phase (connect, greeting, socket) times out after this.
SMTP_TIMEOUT_MS=30000
# A PROCESSING row claimed longer ago than this is treated as crashed and reset
# to SCHEDULED at worker boot. Must be >= 3 x SMTP_TIMEOUT_MS + 30000 (BullMQ lock).
STALE_PROCESSING_MS=600000
RECONCILE_CHUNK_SIZE=500
# Only one booting worker reconciles at a time (Redis SET NX PX lock).
RECONCILE_LOCK_MS=60000

# ---- Bull Board basic auth (M7): /admin/queues on the API ----
# Empty = dashboard not mounted. The placeholder password is refused in production.
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me

# ---- Auth (M8): Google OAuth + signed JWT session cookie ----
# Signs session cookies; at least 32 chars (e.g. openssl rand -hex 32). The placeholder is refused in production.
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime: seconds or 15m / 12h / 7d.
JWT_EXPIRES_IN=7d
# From Google Cloud Console > Credentials > OAuth client (Web). Empty = Google login disabled
# (the server still starts). Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an 'Authorized redirect URI' on the Google OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ---- Slack (M9): placeholders until the Slack app + ngrok https URL exist ----
# Your free static ngrok domain (https://dashboard.ngrok.com/domains), used by `npm run tunnel`.
# The ngrok authtoken is NOT stored here: `ngrok config add-authtoken` keeps it in ngrok's own config.
NGROK_DOMAIN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires https, e.g. https://<id>.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URL=
# 32 bytes as 64 hex chars (AES-256-GCM key for Slack tokens): openssl rand -hex 32
ENCRYPTION_KEY=
